#!/usr/bin/env sh
set -eu

msg_file=$1
subject=$(head -n 1 "$msg_file")

case "$subject" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

if [ "${#subject}" -gt 72 ]; then
  echo "ERROR: el asunto supera 72 caracteres." >&2
  exit 1
fi

pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9._-]+\))?!?: .+$'
if ! printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  echo "ERROR: el asunto debe seguir Conventional Commits." >&2
  echo "Ejemplo: feat(emulators): add TUNeS temporal U-Net and Minkowski stats" >&2
  exit 1
fi
